{"ts": 1794667641.4907265, "tool": "write_file", "args": {"Content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <limits.h>\n\nvoid printLine(const char *line)\n{\n    if (line != NULL)\n    {\n        puts(line);\n    }\n}\n\nvoid printLongLine(long longNumber)\n{\n    printf(\"%ld\\n\", longNumber);\n}\n\nvoid bad(void)\n{\n    long data = 0L;\n    fscanf(stdin, \"%ld\", &data);\n    printLongLine(data - 1);\n}\n\nstatic void goodG2B(void)\n{\n    long data = 0L;\n    data = -2;\n    printLongLine(data - 1);\n}\n\nstatic void goodB2G(void)\n{\n    long data = 0L;\n    fscanf(stdin, \"%ld\", &data);\n    if (data > LONG_MIN)\n    {\n        printLongLine(data - 1);\n    }\n    else\n    {\n        printLine(\"data value is too large to perform subtraction.\");\n    }\n}\n\nvoid good(void)\n{\n    goodG2B();\n    goodB2G();\n}\n\nint main(int argc, char *argv[])\n{\n    const char *mode = (argc > 1) ? argv[1] : \"both\";\n\n    if (strcmp(mode, \"bad\") != 0)\n    {\n        printLine(\"Calling good()...\");\n        good();\n        printLine(\"Finished good()\");\n    }\n\n    if (strcmp(mode, \"good\") != 0)\n    {\n        printLine(\"Calling bad()...\");\n        bad();\n        printLine(\"Finished bad()\");\n    }\n\n    return 0;\n}\n", "Path": "/tmp/run_c0cb8967828d41859082b5020c6c71d4/reconstructed.c"}, "decision": "allow", "reason": null}

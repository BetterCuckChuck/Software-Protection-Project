{
  "model": "gemini-3.8-flash",
  "agentMode": "accept-edits",
  "toolPermission": "always-proceed",
  "artifactReviewPolicy": "always-proceed",
  "permissions": {
    "denyRead": [
      "original/**",
      "obfuscated_src/**",
      ".cache/**",
      "scripts/01_setup_dataset.sh"
    ],
    "denyWrite": [
      "original/**",
      "obfuscated_src/**",
      ".cache/**",
      "bin/**",
      "tests/**",
      "scripts/**",
      "Setting.md"
    ],
    "allowCommands": [
      "objdump *",
      "gdb *",
      "gcc *",
      "./scripts/verify_target.sh *",
      "ls *",
      "cat tests/*"
    ]
  }
}